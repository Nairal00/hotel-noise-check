{
  "permissions": {
    "deny": ["Read(./.env)"]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": ["~/", "~/.ssh", "~/.aws", "./.env"],
      "allowRead": [".", "~/Downloads/hotel-noise-check/hotel-check-10/data"]
    },
    "credentials": {
      "envVars": [
        { "name": "ANTHROPIC_AUTH_TOKEN", "mode": "deny" }
      ]
    }
  }
}
